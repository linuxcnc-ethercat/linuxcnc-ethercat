# Example: two Delta ASDA-B3-E drives in CSV mode, homed by the drives.
# The position loop is closed here with a PID, the drives get a velocity.
#   slave "x" = first drive on the bus  -> joint 0
#   slave "y" = second drive on the bus -> joint 1

loadusr -W lcec_conf ethercat-conf.xml
loadrt lcec
loadrt [KINS]KINEMATICS
loadrt [EMCMOT]EMCMOT servo_period_nsec=[EMCMOT]SERVO_PERIOD num_joints=[KINS]JOINTS
loadrt pid names=pid.x,pid.y

# Bus read first, motion and position loops in the middle, bus write last.
addf lcec.read-all            servo-thread
addf motion-command-handler   servo-thread
addf motion-controller        servo-thread
addf pid.x.do-pid-calcs       servo-thread
addf pid.y.do-pid-calcs       servo-thread
addf lcec.write-all           servo-thread

#=======================================================================
#  X  -  joint 0
#=======================================================================
# srv-pulses-per-rev is set to 500000 by the driver (from eGearRatio).
setp lcec.0.x.pos-scale [DRIVE_X]UNITS_PER_REV

# Homing speeds [0.1 rpm] and acceleration [ms from 0 to 3000 rpm]
setp lcec.0.x.srv-home-velocity-fast [DRIVE_X]HOME_SPEED_FAST
setp lcec.0.x.srv-home-velocity-slow [DRIVE_X]HOME_SPEED_SLOW
setp lcec.0.x.srv-home-accel         [DRIVE_X]HOME_ACCEL

# Software limits of the drive: a backstop behind LinuxCNC's own limits.
# The driver arms them once the drive is homed.
setp lcec.0.x.srv-sw-limit-min    [JOINT_0]MIN_LIMIT
setp lcec.0.x.srv-sw-limit-max    [JOINT_0]MAX_LIMIT
setp lcec.0.x.srv-sw-limit-offset [JOINT_0]HOME_OFFSET
setp lcec.0.x.srv-sw-limit-margin [DRIVE_X]SW_LIMIT_MARGIN

# Position loop
setp pid.x.Pgain     [DRIVE_X]P
setp pid.x.FF1       [DRIVE_X]FF1
setp pid.x.maxoutput [DRIVE_X]MAX_OUTPUT

setp lcec.0.x.srv-enable-volt 1
net x-enable   joint.0.amp-enable-out => lcec.0.x.srv-switch-on lcec.0.x.srv-enable pid.x.enable
net x-fault    lcec.0.x.srv-fault     => joint.0.amp-fault-in

# srv-pos-cmd is not sent to the drive in CSV mode.  The driver needs it
# for srv-pos-fb while the drive is homing.
net x-pos-cmd  joint.0.motor-pos-cmd  => pid.x.command lcec.0.x.srv-pos-cmd
net x-pos-fb   lcec.0.x.srv-pos-fb    => pid.x.feedback joint.0.motor-pos-fb
net x-vel-cmd  pid.x.output          => lcec.0.x.srv-vel-cmd

# Homing: LinuxCNC sets index-enable, the drive homes itself, the driver
# clears index-enable when the drive is done.  The PID needs the signal as
# well, to ignore the position jump at the end of homing.
net x-home     joint.0.index-enable  <=> lcec.0.x.srv-home
net x-home     pid.x.index-enable

#=======================================================================
#  Y  -  joint 1
#=======================================================================
# srv-pulses-per-rev is set to 500000 by the driver (from eGearRatio).
setp lcec.0.y.pos-scale [DRIVE_Y]UNITS_PER_REV

# Homing speeds [0.1 rpm] and acceleration [ms from 0 to 3000 rpm]
setp lcec.0.y.srv-home-velocity-fast [DRIVE_Y]HOME_SPEED_FAST
setp lcec.0.y.srv-home-velocity-slow [DRIVE_Y]HOME_SPEED_SLOW
setp lcec.0.y.srv-home-accel         [DRIVE_Y]HOME_ACCEL

# Software limits of the drive: a backstop behind LinuxCNC's own limits.
# The driver arms them once the drive is homed.
setp lcec.0.y.srv-sw-limit-min    [JOINT_1]MIN_LIMIT
setp lcec.0.y.srv-sw-limit-max    [JOINT_1]MAX_LIMIT
setp lcec.0.y.srv-sw-limit-offset [JOINT_1]HOME_OFFSET
setp lcec.0.y.srv-sw-limit-margin [DRIVE_Y]SW_LIMIT_MARGIN

# Position loop
setp pid.y.Pgain     [DRIVE_Y]P
setp pid.y.FF1       [DRIVE_Y]FF1
setp pid.y.maxoutput [DRIVE_Y]MAX_OUTPUT

setp lcec.0.y.srv-enable-volt 1
net y-enable   joint.1.amp-enable-out => lcec.0.y.srv-switch-on lcec.0.y.srv-enable pid.y.enable
net y-fault    lcec.0.y.srv-fault     => joint.1.amp-fault-in

# srv-pos-cmd is not sent to the drive in CSV mode.  The driver needs it
# for srv-pos-fb while the drive is homing.
net y-pos-cmd  joint.1.motor-pos-cmd  => pid.y.command lcec.0.y.srv-pos-cmd
net y-pos-fb   lcec.0.y.srv-pos-fb    => pid.y.feedback joint.1.motor-pos-fb
net y-vel-cmd  pid.y.output          => lcec.0.y.srv-vel-cmd

# Homing: LinuxCNC sets index-enable, the drive homes itself, the driver
# clears index-enable when the drive is done.  The PID needs the signal as
# well, to ignore the position jump at the end of homing.
net y-home     joint.1.index-enable  <=> lcec.0.y.srv-home
net y-home     pid.y.index-enable

#=======================================================================
#  E-stop (software loopback only - add a real E-stop chain)
#=======================================================================
net estop-loop  iocontrol.0.user-enable-out => iocontrol.0.emc-enable-in

# No tool changer: acknowledge tool changes right away.
net tool-prepare-loopback  iocontrol.0.tool-prepare => iocontrol.0.tool-prepared
net tool-change-loopback   iocontrol.0.tool-change  => iocontrol.0.tool-changed
