<masters>
  <master idx="0" appTimePeriod="1000000" refClockSyncCycles="1000">
    <slave idx="0" type="EK1100" name="coupler"/>
    <!-- baud/dataFrame/rtsCts are startup values only and optional;
         the application (e.g. mb2hal from its INI) overrides them via
         termios when it opens the port -->
    <slave idx="1" type="EL6021" name="vfd">
      <modParam name="ttyName" value="lcec-vfd0"/>
    </slave>
  </master>
</masters>
